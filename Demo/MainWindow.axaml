<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="using:Spreadalonia"
        mc:Ignorable="d" Width="800" Height="450"
        x:Class="Demo.MainWindow"
        Title="Demo"
        WindowState="Maximized">

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem x:Name="OpenFileMenuItem" Header="_Open..." Click="OpenFileMenuItem_Click"/>
        <MenuItem x:Name="SaveFileMenuItem" Header="_Save..." Click="SaveFileMenuItem_Click"/>
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem x:Name="InsertRowMenuItem" Header="Add row _above selection" Click="InsertRowMenuItem_OnClick"/>
        <MenuItem x:Name="AppendRowMenuItem" Header="Add row _below selection" Click="AppendRowMenuItem_OnClick"/>
        <MenuItem x:Name="CopyRowMenuItem" Header="_Copy top selected row to bottom one" Click="CopyRowMenuItem_OnClick"/>
      </MenuItem>
    </Menu>
    <local:SpreadbookEpplus 
      x:Name="spreadbook"
      CellDoubleClicked="Spreadbook_OnCellDoubleClicked"/>
  </DockPanel>

</Window>
