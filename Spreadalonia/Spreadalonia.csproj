<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
	<AssemblyName>Spreadalonia</AssemblyName>
	<RootNamespace>Spreadalonia</RootNamespace>
	<Authors>Giorgio Bianchini</Authors>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<Company>University of Bristol</Company>
	<Description>A simple spreadsheet control for Avalonia.</Description>
	<Version>1.1.0</Version>
	<PackageLicenseExpression>LGPL-3.0-only</PackageLicenseExpression>
	<PackageProjectUrl>https://github.com/arklumpus/Spreadalonia</PackageProjectUrl>
	<PackageIcon>icon.png</PackageIcon>
	<LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\icon.png">
      <Pack>true</Pack>
      <PackagePath>.</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Cursors\*.png" />
    <EmbeddedResource Include="Icons\*.png" />
  </ItemGroup>
	
	<ItemGroup>
		<PackageReference Include="Avalonia" Version="11.0.11" />
		<PackageReference Include="Avalonia.Desktop" Version="11.0.11" />
		<PackageReference Include="EPPlus" Version="6.0.3" />
		<PackageReference Include="Fare" Version="2.2.1" />
		<PackageReference Include="System.Collections.Immutable" Version="7.0.0" />
	</ItemGroup>
	
	<ItemGroup>
	  <AvaloniaXaml Update="Spreadbook.axaml">
	    <SubType>Designer</SubType>
	  </AvaloniaXaml>
	</ItemGroup>
	
	<ItemGroup>
	  <Compile Update="Spreadbook.axaml.cs">
	    <SubType>Code</SubType>
	    <DependentUpon>%(Filename)</DependentUpon>
	  </Compile>
	</ItemGroup>
</Project>
